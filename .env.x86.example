# ===========================================
# .env.x86 — template for amd64 host + NVIDIA GPU
# Copy to .env.x86 and fill in your secrets:  cp .env.x86.example .env.x86
# Use with: docker compose -f docker-compose.x86.yml --env-file .env.x86 up
# ===========================================

# --- Services ---
SERVICE_ORCHESTRATOR=1
SERVICE_CAR_CONTROL=1
SERVICE_CAR_MANUAL=1
SERVICE_VOICE_PROCESSING=1
SERVICE_FRONTEND=
SERVICE_NAVIGATION=
SERVICE_INFOTAINMENT=
SERVICE_CLOUD=

# --- Secrets / vehicle backend (FILL IN) ---
GRAPHQL_API_KEY=
GRAPHQL_HOST=
GRAPHQL_VEHICLE_ID=

# --- Orchestrator ---
ORCHESTRATOR_PORT=8000

# --- LLM ---
OPENAI_API_KEY=
LOCAL_LLM_URL=http://host.docker.internal:8080/v1
LOCAL_LLM_MODEL=google/gemma-4-e2b
# GGUF served by llama-server (see docs/ASSETS.md)
# LLM_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf

# --- HuggingFace token (only needed for gated/private repos in fetch_assets) ---
HF_TOKEN=

# --- Car Control ---
CAR_SIMULATOR_CONNECTED=true
CAR_CONTROL_BASE_URL=http://car_control:8001
CAR_CONTROL_SOUNDS_DIR=/app/sounds

# --- Car Manual ---
HF_HOME=/app/.cache
CAR_MANUAL_BASE_URL=http://car_manual:8002
CAR_MANUAL_BRAND=mmc,toyota
CAR_MANUAL_SEARCH_MODE=embedding
CAR_MANUAL_SCORE_THRESHOLD=0.2

# --- TTS ---
# Leave empty to speak the language detected from each turn (en/ja/vi). Set to a
# fixed code (e.g. en) to force one language.
# TTS_LANGUAGE=en
# Vietnamese TTS (sherpa-onnx Piper). Fetch: scripts/fetch_assets.* tts-vi
PIPER_VI_DIR=/app/agent_assets/models/tts/vits-piper-vi_VN-vais1000-medium

# --- GPU execution providers (cpu | cuda) ---
# cuda only takes effect with CUDA-enabled onnxruntime / sherpa-onnx builds;
# otherwise each stage logs a warning and falls back to cpu automatically.
ONNX_PROVIDER=cpu      # Kokoro TTS + Silero VAD
SHERPA_PROVIDER=cpu    # sherpa-onnx ASR (SenseVoice/Whisper) + wake word
VAD_PROVIDER=cpu

# --- STT ---
# faster_whisper = faster-whisper/CTranslate2 (vi/en/ja, GPU) — khuyến nghị
# sherpa_whisper = sherpa-onnx Whisper (CPU); sherpa_onnx = SenseVoice (en/ja/zh/ko/yue)
# Chọn: faster_whisper | sherpa_whisper | sherpa_onnx | whisper_trt (Jetson) | nemotron | openai | elevenlabs
STT_BACKEND=faster_whisper
# auto = để model tự nhận ngôn ngữ từng câu (vi/en/ja)
STT_LANGUAGE=auto
# faster-whisper (fetch: scripts/fetch_assets.* asr-fw)
FASTER_WHISPER_MODEL=/app/agent_assets/models/faster_whisper/large-v3
FASTER_WHISPER_DEVICE=cuda
FASTER_WHISPER_COMPUTE=float16
FASTER_WHISPER_BEAM=5
# (dự phòng) sherpa-onnx Whisper multilingual
STT_WHISPER_DIR=/app/agent_assets/models/asr_whisper
STT_WHISPER_MODEL=small
STT_WHISPER_INT8=1

# sherpa-onnx SenseVoice ASR
STT_MODEL_DIR=/app/agent_assets/models/asr
STT_MODEL_TYPE=sense_voice

# Nemotron (NVIDIA offline, dùng khi muốn tiếng Anh chất lượng cao)
NEMOTRON_MODEL_ID=nvidia/nemotron-speech-streaming-en-0.6b

# ElevenLabs (cloud)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime
ELEVENLABS_STT_TIMEOUT=20
ELEVENLABS_STT_INCLUDE_TIMESTAMPS=false
ELEVENLABS_STT_NO_VERBATIM=false
ELEVENLABS_STT_COMMIT_STRATEGY=manual

# --- Wake Word ---
# openwakeword: dùng hey_doh_ra.onnx có sẵn
# sherpa_onnx: noise-robust, cần model dir + keywords.txt
WAKE_WORD_BACKEND=openwakeword
WAKE_WORD_MODEL_DIR=/app/agent_assets/models/kws
WAKE_WORD_THRESHOLD=0.5

# --- AEC (webrtc_apm native lib có sẵn: linux/x64 + windows/x64) ---
AEC_ENABLED=1
AEC_DELAY_MS=60
AEC_NOISE_SUPPRESS=1
# NS HIGH + transient click suppression, kiểu xiaozhi AFE.
AEC_NS_LEVEL=moderate
AEC_TRANSIENT_SUPPRESS=1
AEC_HPF_FULL_BAND=1
# AGC2 adaptive digital: tự nâng mic yếu (-45dBFS) lên gần chuẩn, kiểu xiaozhi.
AEC_AGC_ENABLED=1
AEC_AGC_HEADROOM_DB=5.0
AEC_AGC_MAX_GAIN_DB=30.0
AEC_AGC_INITIAL_GAIN_DB=15.0
AEC_AGC_MAX_SPEED_DB=12.0
AEC_AGC_MAX_NOISE_DBFS=-18.0
# AEC_PRE_GAIN: pre-amp cố định (tuyến tính, 1.0 = tắt). Chỉ dùng khi AGC chưa đủ.
AEC_PRE_GAIN=1.0
# NS phân tích linear-AEC output (khử ồn mạnh hơn; mặc định 0).
AEC_NS_LINEAR=1
# AGC1 target-level + limiter (đẩy giọng yếu lên mức chuẩn cho model).
AEC_AGC1_ENABLED=0
AEC_AGC1_TARGET_DBFS=-3
AEC_AGC1_COMPRESSION_DB=9
AEC_AGC1_LIMITER=1

# --- VAD ---
VAD_THRESHOLD_HIGH=0.55
VAD_THRESHOLD_LOW=0.20
# Turn-taking: pause bao lâu thì chốt segment / kết thúc turn (giây).
# SEGMENT 1.0 + END 2.5: nói ngắt nghỉ tự nhiên không bị cắt giữa chừng.
SEGMENT_SILENCE=1.0
TURN_END_SILENCE=1.0
VAD_FIRST_TIMEOUT=8.0
VAD_DETECT_THRESHOLD=0.55
# --- Chống nhiễu / hallucination (tinh chỉnh) ---
# Số frame speech liên tiếp mới coi là có tiếng nói (tăng nếu nhiễu hay kích hoạt).
VAD_WINDOW_SIZE=3
# Bỏ đoạn quá ngắn / quá yếu trước khi đưa vào STT (0 = tắt gate năng lượng).
MIN_SEGMENT_SEC=0.20
STT_MIN_RMS=0.008
# Lọc câu Whisper hay bịa khi gặp nhiễu ("Yeah.", "Thank you.", "(phone beeps)").
STT_DROP_SHORT_HALLUCINATIONS=1
# STT_HALLUCINATION_BLOCKLIST=extra1,extra2

# --- Speaker overlap / diarization (opt-in, GPU via torch CUDA) ---
# Bật để phát hiện nhiều người nói chồng tiếng; cần pyannote + token HF (model gated).
SPEAKER_ENABLED=0
SPEAKER_DEVICE=cuda
SPEAKER_PIPELINE=pyannote/speaker-diarization-community-1
SPEAKER_EMBEDDING=pyannote/embedding
SPEAKER_HF_TOKEN=
# Nếu overlap >= ngưỡng, xin người dùng nhắc lại thay vì đưa audio lẫn vào LLM.
SPEAKER_GATE_OVERLAP=0
SPEAKER_OVERLAP_MIN=0.15
SPEAKER_TARGET_THRESHOLD=0.65
# Target Speaker Extraction (separation + chọn target) trên overlap
SPEAKER_TSE_ENABLED=0
TSE_MODEL=MossFormer2_SS_16K
TSE_REF_SEC=1.5
# Follow-up: sau khi TTS trả lời, nghe tiếp bao lâu mà không cần wake-word.
FOLLOWUP_LISTEN_SEC=12.0
# Pre-roll giữ lại bao nhiêu giây audio trước khi VAD trigger (chống mất chữ đầu).
SPEECH_PREROLL_SEC=0.8
# Grace ngắn cho follow-up (AEC đã khử echo TTS) để không vứt âm đầu câu.
FOLLOWUP_GRACE_SEC=0.2
# Barge-in kiểu xiaozhi: nói chen khi TTS đang phát thì abort reply và nghe turn mới.
BARGE_IN_ENABLED=1
BARGE_IN_MIN_PLAY_SEC=1.0

# --- Audio (x86 host) ---
# 16kHz native kiểu xiaozhi: VAD/wake/STT/APM đều chạy 16k nên bỏ resample,
# giảm méo + CPU. CHUNK 1024@16k = 64ms.
MIC_DEVICE_NAME=default
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK=1024
AUDIO_LATENCY=0.10
PULSE_LATENCY_MSEC=100

# Thread limits (x86 có nhiều core hơn Jetson)
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
ORT_INTRA_OP_NUM_THREADS=2
ORT_INTER_OP_NUM_THREADS=1
TORCH_NUM_THREADS=2
TORCH_NUM_INTEROP_THREADS=1
