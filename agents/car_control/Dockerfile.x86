# syntax=docker/dockerfile:1
# car_control — x86_64 + NVIDIA GPU
# Kế thừa từ x86-base (torch, onnxruntime-gpu, sherpa-onnx đã có sẵn)
ARG BASE_IMAGE=orchestrator-on-edge/x86-base:cu128
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Chỉ cài các deps nhẹ của car_control — KHÔNG cài lại torch
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install \
        "a2a-sdk[http-server]==0.3.24" \
        uvicorn \
        python-dotenv \
        requests \
        "numpy<2" \
        transformers

COPY agents/car_control/*.py ./

CMD ["python3", "main.py"]
