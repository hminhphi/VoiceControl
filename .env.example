# ===========================================
# Edge Orchestrator - template for the Jetson (arm64) .env
# Copy to .env and fill in your secrets:  cp .env.example .env
# ===========================================
# --- Services to start from run_all.sh ---
# Set to 1/true/yes/on to start. Leave empty or comment out to skip.
SERVICE_ORCHESTRATOR=1
SERVICE_CAR_CONTROL=1
SERVICE_CAR_MANUAL=1
SERVICE_FRONTEND=
SERVICE_VOICE_PROCESSING=1
SERVICE_NAVIGATION=
SERVICE_INFOTAINMENT=
SERVICE_CLOUD=

# --- Secrets / vehicle backend (FILL IN) ---
GRAPHQL_API_KEY=
GRAPHQL_HOST=
GRAPHQL_VEHICLE_ID=

# --- Orchestrator ---
ORCHESTRATOR_PORT=8000

# --- LLM (choose OpenAI or Local) ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe

LOCAL_LLM_URL=http://host.docker.internal:8080/v1
LOCAL_LLM_MODEL=qwen3
# GGUF served by llama-server (see docs/ASSETS.md). Absolute dir on the Jetson.
LLM_MODEL_DIR=/home/nvidia/fa_ai/orchestrator-on-edge/llama-cpp/models
LLM_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf

# --- HuggingFace token (only needed for gated/private repos in fetch_assets) ---
HF_TOKEN=

# --- Car Control Agent ---
CAR_SIMULATOR_CONNECTED=true
CAR_CONTROL_BASE_URL=http://car_control:8001
CAR_CONTROL_SOUNDS_DIR=/app/sounds

# --- Car Manual Agent ---
HF_HOME=/app/.cache
CAR_MANUAL_BASE_URL=http://car_manual:8002
CAR_MANUAL_BRAND=mmc
CAR_MANUAL_SEARCH_MODE=embedding
CAR_MANUAL_SCORE_THRESHOLD=0.2

# --- Navigation Agent ---
# NAVIGATION_BASE_URL=http://navigation:8003

# Infotainment
# INFOTAINMENT_BASE_URL=http://infotainment:8004
# INFOTAINMENT_MEDIA_DIR=/app/media

# Cloud
# CLOUD_BASE_URL=http://cloud:8005
# TAVILY_API_KEY=

TTS_LANGUAGE=en
# STT: `whisper` = Whisper trên GPU (Jetson: TensorRT · x86: faster-whisper/CUDA).
# Khác: whisper_trt | faster_whisper | sherpa_whisper | sherpa_onnx (SenseVoice) | nemotron | openai | elevenlabs
STT_BACKEND=whisper
# Whisper model dùng CHUNG cho x86 (faster-whisper) và Jetson (TensorRT).
# Đổi tên model ở đây là đổi cho cả 2 nền tảng (large-v3 = đa ngữ vi/en/ja).
# KHÔNG dùng bản `*.en` (chỉ tiếng Anh).
WHISPER_MODEL=large-v3
# auto = tự nhận ngôn ngữ từng câu (vi/en/ja)
STT_LANGUAGE=auto
# (dự phòng) sherpa-onnx SenseVoice ASR
STT_MODEL_DIR=/app/agent_assets/models/asr
STT_MODEL_TYPE=sense_voice

# Wake word: openwakeword (default, uses hey_doh_ra.onnx) | sherpa_onnx (noise-robust)
WAKE_WORD_BACKEND=openwakeword
# WAKE_WORD_BACKEND=sherpa_onnx
WAKE_WORD_MODEL_DIR=/app/agent_assets/models/kws
WAKE_WORD_THRESHOLD=0.5

# AEC (Acoustic Echo Cancellation) — webrtc_apm native lib có sẵn trong
# voice_processing/libs/webrtc_apm (linux/aarch64 cho Jetson AGX).
AEC_ENABLED=1
AEC_DELAY_MS=60
AEC_NOISE_SUPPRESS=1
# NS HIGH + transient click suppression, kiểu xiaozhi AFE.
AEC_NS_LEVEL=moderate
AEC_TRANSIENT_SUPPRESS=1
AEC_HPF_FULL_BAND=1
# AGC2 adaptive digital: tự nâng mic yếu lên gần chuẩn.
AEC_AGC_ENABLED=1
AEC_AGC_HEADROOM_DB=5.0
AEC_AGC_MAX_GAIN_DB=30.0
AEC_AGC_INITIAL_GAIN_DB=15.0
AEC_AGC_MAX_SPEED_DB=12.0
AEC_AGC_MAX_NOISE_DBFS=-18.0
# AEC_PRE_GAIN: pre-amp cố định (tuyến tính, 1.0 = tắt).
AEC_PRE_GAIN=1.0
# NS phân tích linear-AEC output (khử ồn mạnh hơn; mặc định 0).
AEC_NS_LINEAR=1
# AGC1 target-level + limiter (đẩy giọng yếu lên mức chuẩn cho model).
AEC_AGC1_ENABLED=0
AEC_AGC1_TARGET_DBFS=-3
AEC_AGC1_COMPRESSION_DB=9
AEC_AGC1_LIMITER=1

# VAD dual-threshold (Silero stateful)
VAD_THRESHOLD_HIGH=0.55
VAD_THRESHOLD_LOW=0.20
VAD_DETECT_THRESHOLD=0.55
VAD_FIRST_TIMEOUT=8.0
# --- Chống nhiễu / hallucination (tinh chỉnh) ---
# Số frame speech liên tiếp mới coi là có tiếng nói (tăng nếu nhiễu hay kích hoạt).
VAD_WINDOW_SIZE=3
# Bỏ đoạn quá ngắn / quá yếu trước khi đưa vào STT (0 = tắt gate năng lượng).
MIN_SEGMENT_SEC=0.20
STT_MIN_RMS=0.008
# Lọc câu Whisper hay bịa khi gặp nhiễu ("Yeah.", "Thank you.", "(phone beeps)").
STT_DROP_SHORT_HALLUCINATIONS=1
# STT_HALLUCINATION_BLOCKLIST=extra1,extra2

# --- Speaker overlap / diarization (opt-in, GPU via torch CUDA) ---
# Bật để phát hiện nhiều người nói chồng tiếng; cần pyannote + token HF (model gated).
SPEAKER_ENABLED=0
SPEAKER_DEVICE=cuda
SPEAKER_PIPELINE=pyannote/speaker-diarization-community-1
SPEAKER_EMBEDDING=pyannote/embedding
SPEAKER_HF_TOKEN=
SPEAKER_GATE_OVERLAP=0
SPEAKER_OVERLAP_MIN=0.15
SPEAKER_TARGET_THRESHOLD=0.65
# Target Speaker Extraction (separation + chọn target) trên overlap
SPEAKER_TSE_ENABLED=0
TSE_MODEL=MossFormer2_SS_16K
TSE_REF_SEC=1.5
# Turn-taking: SEGMENT 1.0 + END 2.5 chống ngắt giữa chừng.
SEGMENT_SILENCE=1.0
TURN_END_SILENCE=1.0
# Pre-roll 0.8s chống mất chữ đầu; follow-up 12s không cần wake-word.
SPEECH_PREROLL_SEC=0.8
FOLLOWUP_LISTEN_SEC=12.0
FOLLOWUP_GRACE_SEC=0.2
# Barge-in kiểu xiaozhi: nói chen khi TTS đang phát.
BARGE_IN_ENABLED=1
BARGE_IN_MIN_PLAY_SEC=1.0
ORCH_AUDIT_ENABLED=0

# Bluetooth (setup_blue.sh)
SPEAKER_MAC_ADDRESS=
# Bluetooth output profile: a2dp (stereo/high quality) or hfu (handsfree/mono).
BLUETOOTH_AUDIO_PROFILE=hfu

#AUDIO_MODE=usb
AUDIO_MODE=bluetooth
AUDIO_READY_TIMEOUT=120
MIC_DEVICE_NAME=pulse
# 16kHz native kiểu xiaozhi (VAD/wake/STT/APM đều 16k, bỏ resample).
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK=1024

# Only use when AUDIO_MODE=usb
# PULSE_SINK=
# PULSE_SOURCE=

# Password used by run_all.sh for sudo steps
SUDO_PWD=
