# ============================================================
# Orchestrator-on-Edge .gitignore
#
# Rule of thumb: only source, config, docs and small custom
# assets are tracked. Large/downloadable models and all local
# state (env, venvs, caches, builds, logs) are ignored.
# Use scripts/fetch_assets.* to download models.
# ============================================================

# ── Secrets / local config ──────────────────────────────────
.env
.env.x86
**/.env
*.local

# ── External repos & tooling (not part of this source tree) ─
.artifacts/
jetson-containers/
.agents/
.codex/

# ── Python caches & virtual environments ────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venvs/
venv/
env/
**/.venv_docker/
.ipynb_checkpoints/
.pytest_cache/
.tox/
.coverage
htmlcov/
*.egg-info/

# ── Downloaded models & large binaries (see docs/ASSETS.md) ─
cache/
llama-cpp/models/*.gguf
voice_processing/wheels/
voice_processing/kokoro_tts/*.onnx
voice_processing/kokoro_tts/*.bin
voice_processing/agent_assets/models/asr/
voice_processing/agent_assets/models/asr_whisper/
voice_processing/agent_assets/models/faster_whisper/
# faster-whisper CTranslate2 weights (~3 GB, đóng kèm bundle Jetson cho offline)
voice_processing/agent_assets/models/faster-whisper-large-v3/
voice_processing/agent_assets/models/whisper/
voice_processing/agent_assets/models/tts/
voice_processing/agent_assets/models/kws/*.onnx
# release archives sinh ra ngoài (đóng gói F: / GitHub release)
release-*.zip
voice_processing/checkpoints/
/checkpoints/
voice_processing/tools/audio_lab/recordings/

# ── Build / distribution outputs ────────────────────────────
build/
dist/
voice_processing/torch2trt/build/
voice_processing/torch2trt/dist/
voice_processing/whisper_trt/build/
voice_processing/whisper_trt/dist/

# ── Runtime data & logs ─────────────────────────────────────
logs/
*.log
voice_processing/cache/
voice_processing/output/
voice_processing/input_test/
*.host-link-backup/
xet/logs/

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
.eslintcache
frontend/client/dist/

# ── IDE settings ────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ── OS generated ────────────────────────────────────────────
.DS_Store
Thumbs.db

# apt .debs cho build offline (không lên git, nhưng pack_jetson vẫn đóng zip)
vendor/apt-debs/*.deb
